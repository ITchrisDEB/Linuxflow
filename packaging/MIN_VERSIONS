# Minimum base checked by install.sh (KEY=value format, one per line).
# The values can be changed without touching the script.
#
# Interface libraries: Cargo features v4_12 / v1_4, never above.
GTK_MIN=4.12
ADW_MIN=1.4
# glibc: the most recent glibc required by the distributed binaries (2.39 = Ubuntu 24.04). Verified with
# `objdump -T bin/linuxflow` on the binaries actually built (the highest symbol version is GLIBC_2.39).
GLIBC_MIN=2.39
