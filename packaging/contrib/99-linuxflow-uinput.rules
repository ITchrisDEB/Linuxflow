# LinuxFlow: access to /dev/uinput to inject the paste keystrokes.
# NOT installed by default: enable it with `install.sh --with-uinput-rule` (root).
# WARNING: any application of the session or of the `input` group will be able to create
# a virtual keyboard, and therefore to simulate keystrokes. Only enable it if you need it.
KERNEL=="uinput", GROUP="input", MODE="0660", TAG+="uaccess"
